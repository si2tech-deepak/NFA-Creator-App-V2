<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">

    <Dialog
        title="Upload QCS Excel"
        draggable="true"
        resizable="true"
        contentWidth="420px">

        <VBox class="sapUiSmallMargin">
            <Text text="Select the QCS Excel template file (.xlsx) you downloaded and filled in." wrapping="true" class="sapUiSmallMarginBottom"/>
            <unified:FileUploader
                id="fileUploader"
                width="100%"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                placeholder="Choose Excel file (.xlsx only)"
                uploadOnChange="false"
                change="onFileChange"
                typeMissmatch="onFileTypeMismatch"/>
            <MessageStrip
                id="uploadErrorStrip"
                text="Only .xlsx files are accepted."
                type="Error"
                showIcon="true"
                visible="false"
                class="sapUiSmallMarginTop"/>
        </VBox>

        <beginButton>
            <Button
                text="Upload"
                type="Emphasized"
                press="onUploadToServer"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCloseUploadDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>

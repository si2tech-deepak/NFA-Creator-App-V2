<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="createDialog"
        title="Ariba Request"
        draggable="true"
        resizable="true"
        contentWidth="400px">

        <VBox class="sapUiSmallMargin">

            <!-- RADIO BUTTON GROUP -->
            <!-- <RadioButtonGroup
                id="rbGroup"
                columns="2"
                selectedIndex="{createModel>/selectedIndex}"
                select=".onRadioSelect">

                <RadioButton text="Coal"/>
                <RadioButton text="Material"/>

            </RadioButtonGroup> -->

            <!-- DOCUMENT NUMBER -->
            <Label
                text="Document Number"
                labelFor="docInput"
                class="sapUiSmallMarginTop"/>

            <Input
                id="docInput"
                value="{createModel>/documentNo}"
                
                placeholder="Select Document Number"/>

        </VBox>

        <!-- FOOTER -->
        <beginButton>
            <Button text="Create" type="Emphasized" press=".onConfirmCreate"/>
        </beginButton>

        <endButton>
            <Button text="Cancel" press=".onCloseCreate"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>

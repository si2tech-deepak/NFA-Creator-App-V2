<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:unified="sap.ui.unified">

  <Dialog id="vendorAttachDialog"
    title="{testModel>/vendorName} - Attachments"
    contentWidth="700px"
    draggable="true"
    resizable="true">

    <content>
      <VBox class="sapUiSmallMargin">

        <!-- Existing documents from backend -->
        <Title text="Existing Documents" level="H5"/>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <ObjectStatus text="{testModel>/fetchStatus}" state="{testModel>/fetchStatusState}"/>
        </HBox>
        <Table items="{testModel>/existingFiles}"
          noDataText="No existing documents found."
          alternateRowColors="true"
          class="sapUiSmallMarginBottom">
          <columns>
            <Column width="3rem"><Text text="#"/></Column>
            <Column><Text text="File Name"/></Column>
            <Column><Text text="SharePoint Link"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{testModel>idx}"/>
                <Link text="{testModel>SupplierDoc}" press="onPreviewExistingAttachment"/>
                <Link text="{testModel>SupplierSpl}" href="{testModel>SupplierSpl}" target="_blank"
                  visible="{= !!${testModel>SupplierSpl} }"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <!-- New Documents toolbar -->
        <Title text="New Documents" level="H5" class="sapUiSmallMarginTop"/>
        <OverflowToolbar style="Clear">
          <ToolbarSpacer/>
          <Button icon="sap-icon://add" text="Add Attachment"
            type="Emphasized" press="onAddVendorAttachRow"/>
        </OverflowToolbar>

        <!-- New documents table -->
        <Table id="vendorStagedFilesTable"
          items="{testModel>/stagedFiles}"
          noDataText="Click 'Add Attachment' to add a row."
          alternateRowColors="true">
          <columns>
            <Column width="3rem" hAlign="Center"><Text text="Sl."/></Column>
            <Column><Text text="File Name"/></Column>
            <Column width="9rem" hAlign="Center"><Text text="Upload File"/></Column>
            <Column><Text text="SharePoint Link"/></Column>
            <Column width="3rem" hAlign="Center"><Text text=""/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{testModel>idx}"/>
                <Text text="{testModel>fileName}"/>
                <unified:FileUploader
                  buttonOnly="true"
                  buttonText="Browse"
                  uploadOnChange="false"
                  fileType="pdf,png,jpg,jpeg,xlsx,docx"
                  change="onVendorAttachRowFileChange"/>
                <Input
                  value="{testModel>supplierSpl}"
                  placeholder="Paste SharePoint URL"
                  width="100%"/>
                <Button icon="sap-icon://delete" type="Transparent"
                  press="onRemoveVendorAttachFile"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </content>

    <buttons>
      <Button text="Save" type="Emphasized" press="onConfirmVendorAttach"/>
      <Button text="Close" press="onCloseVendorAttachDialog"/>
    </buttons>

  </Dialog>

</core:FragmentDefinition>

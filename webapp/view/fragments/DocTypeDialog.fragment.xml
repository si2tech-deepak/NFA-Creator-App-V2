<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    
    <Dialog
        id="docTypeDialog"
        title="Select Document Type"
        contentWidth="400px">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Document Type" required="true"/>
                <Select id="docTypeSelect" selectedKey="{docTypeModel>/selectedType}">
                    <core:Item key="Standard" text="Standard"/>
                    <core:Item key="Subcontracting" text="Subcontracting"/>
                    <core:Item key="Consignment" text="Consignment"/>
                    <core:Item key="Service" text="Service"/>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press="onConfirmDocType"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseDocTypeDialog"/>
        </endButton>
    </Dialog>
    
</core:FragmentDefinition>

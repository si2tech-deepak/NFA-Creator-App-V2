<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="createDocumentDialog" title="Create Document - {cdModel>/selectedNfaIds}" contentWidth="480px" draggable="true"
        busy="{cdModel>/busy}" busyIndicatorDelay="0">
        <VBox class="sapUiMediumMargin">

            <!-- NEW (Phase 2 - Contract Type): Document Type/Category is now chosen at NFA
                 creation time (see nfaCreate.controller.js), so the approver just sees what
                 was already selected - no selection is made here any more. -->
            <VBox visible="{cdModel>/docTypeKnown}">
                <Label text="Document Type"/>
                <Text text="{cdModel>/docTypeDisplay}"/>
                <Label text="Document Category" class="sapUiTinyMarginTop"/>
                <Text text="{cdModel>/docCategoryDisplay}"/>
            </VBox>

            <!-- Backfill path (NEW, Phase 2 - Contract Type): only shown for NFAs created
                 before this feature existed, which have no saved Document Type. Reuses the
                 original editable radio + dropdown selection so a document can still be
                 created for them. -->
            <VBox visible="{= !${cdModel>/docTypeKnown} }">
                <Title text="Select Document Type" level="H5" class="sapUiTinyMarginBottom"/>
                <RadioButtonGroup id="backfillDocTypeRadioGroup" columns="1" select="onBackfillDocTypeChange">
                    <buttons>
                        <RadioButton id="rbContract" text="Contract"/>
                        <RadioButton id="rbSA"       text="Scheduling Agreement"/>
                        <RadioButton id="rbPO"       text="Purchase Order"/>
                    </buttons>
                </RadioButtonGroup>

                <!-- Doc Type dropdown (shown after radio selection) -->
                <VBox visible="{cdModel>/docTypeVisible}" class="sapUiSmallMarginTop">
                    <Label text="{cdModel>/docTypeLabel}" required="true"/>
                    <Select id="docTypeSelect" width="100%"
                        forceSelection="false"
                        items="{cdModel>/docTypes}"
                        selectedKey="{cdModel>/selectedDocType}"
                        change="onBackfillDocCategoryChange">
                        <core:Item key="{cdModel>KeyDataType}" text="{cdModel>Description}"/>
                    </Select>
                </VBox>
            </VBox>

        </VBox>

        <beginButton>
            <Button text="Create" type="Emphasized" icon="sap-icon://create"
                press="onConfirmCreateDocument"
                enabled="{= !!${cdModel>/selectedDocType} &amp;&amp; !${cdModel>/busy} }"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseCreateDocument"/>
        </endButton>
    </Dialog>

</core:FragmentDefinition>
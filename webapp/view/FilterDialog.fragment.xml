<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:forms="sap.ui.layout.form">

    <Dialog
        title="Filter"
        contentWidth="500px"
        draggable="true"
        resizable="true">

        <VBox class="sapUiSmallMargin">
            <forms:SimpleForm layout="ColumnLayout" columnsXL="2" columnsL="2" columnsM="1" editable="true">

                <Label text="NFA Expression"/>
                <Input id="filterNFAExpression" placeholder="Enter NFA Expression"/>

                <Label text="From Date"/>
                <DatePicker id="filterStartDate" displayFormat="dd MMM yyyy" valueFormat="yyyy-MM-dd" placeholder="Start Date"/>

                <Label text="To Date"/>
                <DatePicker id="filterEndDate" displayFormat="dd MMM yyyy" valueFormat="yyyy-MM-dd" placeholder="End Date"/>

                <Label text="Status"/>
                <Select id="filterStatus" forceSelection="false">
                    <core:Item key="" text="All"/>
                    <core:Item key="Approved" text="Approved"/>
                    <core:Item key="Pending" text="Pending"/>
                    <core:Item key="Rejected" text="Rejected"/>
                </Select>

            </forms:SimpleForm>
        </VBox>

        <beginButton>
            <Button text="Apply Filter" type="Emphasized" press="onApplyFilter"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseFilter"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
